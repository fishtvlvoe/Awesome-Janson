# Awesome-Janson optional fal.ai B-roll provider
# Copy only the needed values to a local .env, keep it chmod 600, and never commit it.
FAL_KEY=

# fal-image defaults to fal-ai/flux/schnell when blank. fal also proxies GPT Image 2 without OPENAI_API_KEY:
# AWJ_FAL_IMAGE_MODEL=openai/gpt-image-2
# Example of model-specific input fields, as one JSON object (optional):
# AWJ_FAL_IMAGE_INPUT_JSON={"quality":"medium","output_format":"jpeg"}
AWJ_FAL_IMAGE_MODEL=

# fal-video intentionally has no default because video models and pricing vary.
# Text-to-video and image-to-video both need an explicit endpoint ID.
# AWJ_FAL_VIDEO_MODEL=fal-ai/kling-video/o3/standard/image-to-video
AWJ_FAL_VIDEO_MODEL=
# AWJ_FAL_VIDEO_INPUT_JSON={"generate_audio":false}

# Per remote queue request; valid range is 10-600 seconds.
# AWJ_FAL_TIMEOUT_SECONDS=180
